generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// ENUMS
// =========================================================

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum StockMovementType {
  IN
  OUT
  RETURN
  ADJUSTMENT
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// =========================================================
// USER AND AUTHENTICATION
// =========================================================

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  password        String // bcrypt/argon2 hash
  name            String?
  lastName        String?
  phone           String?
  role            Role      @default(CUSTOMER)
  emailVerified   Boolean   @default(false)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // soft delete

  // Relations
  cart                Cart?
  wishlist            Wishlist[]
  orders              Order[]
  addresses           Address[]
  reviews             Review[]
  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
  couponUses          CouponUse[]
  stockMovements      StockMovement[]

  @@index([email])
}

// For JWT with revocable refresh tokens
model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
}

// Email verification and password recovery
model VerificationToken {
  id        Int                    @id @default(autoincrement())
  token     String                 @unique
  userId    Int
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationTokenType
  used      Boolean                @default(false)
  expiresAt DateTime
  createdAt DateTime               @default(now())

  @@index([userId])
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  RESET_PASSWORD
}

model Address {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String? // "Home", "Work"...
  fullName   String
  street     String
  number     String?
  floorDoor  String?
  city       String
  province   String
  postalCode String
  country    String
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  @@index([userId])
}

// =========================================================
// CATALOG
// =========================================================

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  active   Boolean   @default(true)
  products Product[]
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String
  price       Decimal   @db.Decimal(10, 2)
  stock       Int       @default(0)
  sku         String?   @unique
  active      Boolean   @default(true)
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft delete: keeps order history intact

  // Relations
  images         ProductImage[]
  variants       ProductVariant[]
  cartItems      CartItem[]
  wishlists      Wishlist[]
  orderItems     OrderItem[]
  reviews        Review[]
  stockMovements StockMovement[]

  @@index([categoryId])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)
  isMain    Boolean @default(false)

  @@index([productId])
}

// For sizes, colors, etc. Each variant can have its own stock/price/sku
model ProductVariant {
  id          Int     @id @default(autoincrement())
  productId   Int
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String // "Size"
  value       String // "M", "Red"...
  variantSku  String? @unique
  extraPrice  Decimal @default(0) @db.Decimal(10, 2) // added to base price
  stock       Int     @default(0)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, name, value])
  @@index([productId])
}

// Traceability of stock in/out movements
model StockMovement {
  id        Int                @id @default(autoincrement())
  productId Int
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      StockMovementType
  quantity  Int // positive or negative depending on type
  reason    String? // "Sale #123", "Restock from supplier X"...
  userId    Int? // who generated the movement (admin), null if automatic
  user      User?              @relation(fields: [userId], references: [id])
  createdAt DateTime           @default(now())

  @@index([productId])
}

// =========================================================
// CART
// =========================================================

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        Int             @id @default(autoincrement())
  cartId    Int
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)

  @@unique([cartId, productId, variantId])
}

// =========================================================
// COUPONS / DISCOUNTS
// =========================================================

model Coupon {
  id                Int          @id @default(autoincrement())
  code              String       @unique
  type              DiscountType
  value             Decimal      @db.Decimal(10, 2) // % or fixed amount depending on type
  active            Boolean      @default(true)
  maxUses           Int? // null = unlimited
  currentUses       Int          @default(0)
  minAmount         Decimal?     @db.Decimal(10, 2)
  startDate         DateTime     @default(now())
  expirationDate    DateTime?
  createdAt         DateTime     @default(now())

  uses   CouponUse[]
  orders Order[]
}

// Records which user used which coupon on which order (prevents improper reuse)
model CouponUse {
  id        Int      @id @default(autoincrement())
  couponId  Int
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
}

// =========================================================
// ORDERS AND PAYMENTS
// =========================================================

model Order {
  id                Int         @id @default(autoincrement())
  userId            Int
  user              User        @relation(fields: [userId], references: [id])
  status            OrderStatus @default(PENDING)
  subtotal          Decimal     @db.Decimal(10, 2)
  discount          Decimal     @default(0) @db.Decimal(10, 2)
  shippingCost      Decimal     @default(0) @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  couponId          Int?
  coupon            Coupon?     @relation(fields: [couponId], references: [id])
  shippingAddressId Int
  shippingAddress   Address     @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddressId  Int
  billingAddress    Address     @relation("BillingAddress", fields: [billingAddressId], references: [id])
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([status])
}

// Snapshot: stores name and price at purchase time,
// so future changes to Product don't alter orders already placed
model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product         @relation(fields: [productId], references: [id])
  variantId   Int?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  name        String // snapshot
  variantText String? // readable snapshot, e.g. "Size: M"
  price       Decimal         @db.Decimal(10, 2) // snapshot
  quantity    Int

  @@index([orderId])
}

model Payment {
  id            Int           @id @default(autoincrement())
  orderId       Int           @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String // "stripe", "paypal"...
  transactionId String        @unique // ID returned by the payment gateway
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("EUR")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// =========================================================
// WISHLIST AND REVIEWS
// =========================================================

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String?
  approved  Boolean  @default(true) // in case you want to moderate reviews
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}
